# Server-only market configuration. Copy selected settings to ignored .env.local.
# Never put real credentials in this example or NEXT_PUBLIC_* variables.
# Local Next dev server: use the same DEVELOPMENT deployment for URL/admin key.
# TIKR_PERSONAL_DATA_ENABLED=explicit
# TIKR_MARKET_MODE=personal-provisional
# TIKR_CONVEX_URL=https://YOUR-DEV-DEPLOYMENT.convex.cloud
# TIKR_CONVEX_ADMIN_KEY=YOUR_PRIVATE_DEVELOPMENT_ADMIN_KEY
# Leave TIKR_MARKET_HOSTED_ORIGIN entirely unset for local HTTP/loopback mode.
# Local mode also requires its admission ledger/review; see market-data-integration.md.
# Hosted: exact HTTPS origin, no path/trailing slash. Leave unset for local mode.
# TIKR_MARKET_HOSTED_ORIGIN=https://tikr.example
# TIKR_HOSTED_DATA_ENABLED=explicit
# TIKR_MARKET_MODE=personal-provisional
# TIKR_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
TIKR_MARKET_GATEWAY_KEY=
# Used by either mode. Omit these canonical variables when using legacy fallback.
# ALPACA_API_KEY_ID=YOUR_PRIVATE_ALPACA_KEY_ID
# ALPACA_API_SECRET_KEY=YOUR_PRIVATE_ALPACA_SECRET
# Legacy APCA_API_KEY / APCA_API_SECRET are fallback names only when the
# corresponding canonical variable is absent. Do not configure both sets.
# Hosted Convex needs the matching gateway key and explicit enable flag.
# See hosted-operation.md for admission review and activation prerequisites.
# Local-only: TIKR_PERSONAL_DATA_ENABLED, TIKR_CONVEX_URL,
# TIKR_CONVEX_ADMIN_KEY; reviewed replay also requires the evidence file/digest.
